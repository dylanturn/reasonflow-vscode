{
  "name": "reasonflow",
  "displayName": "ReasonFlow",
  "description": "VSCode extension for developing ReasonFlow workflows",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "reasonflow",
    "workflow",
    "llm",
    "rag",
    "ai",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dylanturn/reasonflow-vscode"
  },
  "publisher": "dylanturn",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "reasonflow",
        "aliases": [
          "ReasonFlow",
          "reasonflow"
        ],
        "extensions": [
          ".reasonflow",
          ".reasonflow.json"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "reasonflow",
        "scopeName": "source.reasonflow",
        "path": "./syntaxes/reasonflow.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "json",
        "path": "./snippets/reasonflow.code-snippets"
      },
      {
        "language": "reasonflow",
        "path": "./snippets/reasonflow.code-snippets"
      },
      {
        "language": "python",
        "path": "./snippets/reasonflow.code-snippets"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "*.reasonflow.json",
          "*.reasonflow"
        ],
        "url": "./schemas/reasonflow-workflow.schema.json"
      }
    ],
    "commands": [
      {
        "command": "reasonflow.createWorkflow",
        "title": "ReasonFlow: Create New Workflow"
      },
      {
        "command": "reasonflow.validateWorkflow",
        "title": "ReasonFlow: Validate Workflow"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
