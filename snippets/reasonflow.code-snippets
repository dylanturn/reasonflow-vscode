{
  "Basic Workflow Structure": {
    "prefix": "rf-workflow",
    "body": [
      "{",
      "  \"name\": \"${1:MyWorkflow}\",",
      "  \"description\": \"${2:Workflow description}\",",
      "  \"version\": \"${3:1.0.0}\",",
      "  \"tasks\": {",
      "    \"${4:task1}\": {",
      "      \"type\": \"${5|llm,data_retrieval,custom,rag,api|}\",",
      "      \"config\": {",
      "        $0",
      "      }",
      "    }",
      "  }",
      "}"
    ],
    "description": "Create a basic ReasonFlow workflow structure"
  },
  "LLM Task": {
    "prefix": "rf-task-llm",
    "body": [
      "\"${1:task-name}\": {",
      "  \"type\": \"llm\",",
      "  \"config\": {",
      "    \"params\": {",
      "      \"prompt\": \"${2:Your prompt here}\",",
      "      \"model\": \"${3:gpt-4o}\",",
      "      \"provider\": \"${4|openai,groq,ollama,anthropic|}\",",
      "      \"temperature\": ${5:0.7},",
      "      \"max_tokens\": ${6:1000}",
      "    }",
      "  }",
      "}"
    ],
    "description": "Create an LLM task"
  },
  "RAG/Data Retrieval Task": {
    "prefix": "rf-task-rag",
    "body": [
      "\"${1:task-name}\": {",
      "  \"type\": \"data_retrieval\",",
      "  \"config\": {",
      "    \"agent_config\": {",
      "      \"db_path\": \"${2:vector_db.index}\",",
      "      \"db_type\": \"${3|faiss,pinecone,milvus,qdrant,weaviate|}\",",
      "      \"embedding_provider\": \"${4:sentence_transformers}\",",
      "      \"embedding_model\": \"${5:all-MiniLM-L6-v2}\",",
      "      \"use_gpu\": ${6|true,false|}",
      "    },",
      "    \"params\": {",
      "      \"query\": \"${7:Your search query}\",",
      "      \"top_k\": ${8:5}",
      "    }",
      "  }",
      "}"
    ],
    "description": "Create a RAG/data retrieval task"
  },
  "Custom Task": {
    "prefix": "rf-task-custom",
    "body": [
      "\"${1:task-name}\": {",
      "  \"type\": \"custom\",",
      "  \"config\": {",
      "    \"function_path\": \"${2:path/to/function.py}\",",
      "    \"params\": {",
      "      $0",
      "    }",
      "  }",
      "}"
    ],
    "description": "Create a custom task"
  },
  "Task with Dependencies": {
    "prefix": "rf-task-deps",
    "body": [
      "\"${1:task-name}\": {",
      "  \"type\": \"${2|llm,data_retrieval,custom|}\",",
      "  \"config\": {",
      "    \"params\": {",
      "      \"prompt\": \"${3:Process the output from previous task: {{${4:previous-task}.output}}}\",",
      "      $0",
      "    }",
      "  }",
      "}"
    ],
    "description": "Create a task with template variable references"
  },
  "Workflow Dependencies": {
    "prefix": "rf-dependencies",
    "body": [
      "\"dependencies\": [",
      "  {",
      "    \"from\": \"${1:source-task}\",",
      "    \"to\": \"${2:target-task}\"",
      "  }$0",
      "]"
    ],
    "description": "Define workflow task dependencies"
  },
  "Workflow Input Schema": {
    "prefix": "rf-input-schema",
    "body": [
      "\"input_schema\": [",
      "  {",
      "    \"name\": \"${1:param_name}\",",
      "    \"type\": \"${2|string,number,boolean,object,array|}\",",
      "    \"required\": ${3|true,false|},",
      "    \"description\": \"${4:Parameter description}\"",
      "  }$0",
      "]"
    ],
    "description": "Define workflow input schema"
  },
  "Complete Multi-Task Workflow": {
    "prefix": "rf-workflow-complete",
    "body": [
      "{",
      "  \"name\": \"${1:CompleteWorkflow}\",",
      "  \"description\": \"${2:A complete multi-task workflow}\",",
      "  \"version\": \"${3:1.0.0}\",",
      "  \"tasks\": {",
      "    \"ingest-data\": {",
      "      \"type\": \"data_retrieval\",",
      "      \"config\": {",
      "        \"agent_config\": {",
      "          \"db_path\": \"${4:vector_db.index}\",",
      "          \"db_type\": \"faiss\",",
      "          \"embedding_provider\": \"sentence_transformers\",",
      "          \"embedding_model\": \"all-MiniLM-L6-v2\"",
      "        },",
      "        \"params\": {",
      "          \"query\": \"${5:Retrieve relevant data}\",",
      "          \"top_k\": 10",
      "        }",
      "      }",
      "    },",
      "    \"process-data\": {",
      "      \"type\": \"llm\",",
      "      \"config\": {",
      "        \"params\": {",
      "          \"prompt\": \"Process the following data: {{ingest-data.output}}\",",
      "          \"model\": \"gpt-4o\",",
      "          \"provider\": \"openai\"",
      "        }",
      "      }",
      "    },",
      "    \"generate-summary\": {",
      "      \"type\": \"llm\",",
      "      \"config\": {",
      "        \"params\": {",
      "          \"prompt\": \"Generate a summary: {{process-data.output}}\",",
      "          \"model\": \"gpt-4o\",",
      "          \"provider\": \"openai\"",
      "        }",
      "      }",
      "    }",
      "  },",
      "  \"dependencies\": [",
      "    { \"from\": \"ingest-data\", \"to\": \"process-data\" },",
      "    { \"from\": \"process-data\", \"to\": \"generate-summary\" }",
      "  ]",
      "}"
    ],
    "description": "Create a complete multi-task workflow with dependencies"
  },
  "Python Workflow Builder": {
    "prefix": "rf-python-workflow",
    "body": [
      "from reasonflow.orchestrator.workflow_builder import WorkflowBuilder",
      "from reasonflow.integrations.llm_integrations import LLMIntegration",
      "from reasonflow.tasks.task_manager import TaskManager",
      "import os",
      "",
      "# Initialize components",
      "task_manager = TaskManager()",
      "workflow_builder = WorkflowBuilder(task_manager=task_manager)",
      "",
      "# Create LLM agent",
      "llm = LLMIntegration(",
      "    provider=\"${1|openai,groq,ollama,anthropic|}\",",
      "    model=\"${2:gpt-4o}\",",
      "    api_key=os.getenv(\"${3:OPENAI_API_KEY}\")",
      ")",
      "",
      "# Define workflow",
      "workflow_config = {",
      "    \"tasks\": {",
      "        \"${4:task1}\": {",
      "            \"type\": \"llm\",",
      "            \"config\": {",
      "                \"agent\": llm,",
      "                \"params\": {",
      "                    \"prompt\": \"${5:Your prompt here}\"",
      "                }",
      "            }",
      "        }",
      "    }",
      "}",
      "",
      "# Create and execute workflow",
      "workflow_id = workflow_builder.create_workflow(workflow_config)",
      "results = workflow_builder.execute_workflow(workflow_id)",
      "$0"
    ],
    "description": "Create a ReasonFlow workflow in Python"
  },
  "Python RAG Integration": {
    "prefix": "rf-python-rag",
    "body": [
      "from reasonflow.integrations.rag_integrations import RAGIntegration",
      "",
      "# Initialize RAG",
      "rag = RAGIntegration(",
      "    db_path=\"${1:my_vectors.index}\",",
      "    db_type=\"${2|faiss,pinecone,milvus|}\",",
      "    embedding_model=\"${3:all-MiniLM-L6-v2}\"",
      ")",
      "",
      "# Add documents",
      "rag.add_documents(file_path=\"${4:document.pdf}\")",
      "",
      "# Search",
      "results = rag.search(\"${5:Your query}\", top_k=${6:5})",
      "$0"
    ],
    "description": "Create a RAG integration in Python"
  }
}
